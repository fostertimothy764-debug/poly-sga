generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// role: "sga_admin" | "sga_member" | "class" | "club"
//   sga_admin   = President / Chief of Staff / site admin (full access)
//   sga_member  = other SGA exec (post schoolwide, edit OWN team profile only)
//   class       = class officer (post to own class only); classYear set
//   club        = club officer (post to own club only); clubId set
model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("sga_member")
  siteAdmin    Boolean  @default(false)
  classYear    String?
  clubId       String?
  teamMemberId String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  club       Club?       @relation(fields: [clubId], references: [id], onDelete: SetNull)
  teamMember TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
}

model Club {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  meetingTime String?
  location    String?
  photoUrl    String?
  createdAt   DateTime @default(now())

  admins        Admin[]
  announcements Announcement[]
  events        Event[]
  suggestions   Suggestion[]
  links         ResourceLink[]
}

// audience: "all" | "27" | "28" | "29" | "30" | "club"
model Announcement {
  id         String   @id @default(cuid())
  title      String
  body       String
  pinned     Boolean  @default(false)
  audience   String   @default("all")
  clubId     String?
  authorName String?
  leadImage  String?  // base64 data-URL or https URL; used for home-page lead crop
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  club Club? @relation(fields: [clubId], references: [id], onDelete: SetNull)
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String
  location    String
  audience    String    @default("all")
  clubId      String?
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime  @default(now())

  club Club? @relation(fields: [clubId], references: [id], onDelete: SetNull)
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  grade       String
  bio         String?
  photoUrl    String?
  pronouns    String?
  askMeAbout  String?  // one-liner, max 140 chars enforced at API
  schoolEmail String?
  instagram   String?  // handle without leading @
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  admin Admin?
}

// target: "sga" | "27" | "28" | "29" | "30" | "club"
//   sga    = SGA inbox only (default; not specified)
//   class  = class inbox + SGA inbox
//   club   = club inbox + SGA inbox
// status: "new" | "under_review" | "on_the_agenda" | "in_progress" | "done" | "declined" | "custom"
model Suggestion {
  id                  String   @id @default(cuid())
  body                String
  category            String   @default("general")
  target              String   @default("sga")
  clubId              String?
  contact             String?
  read                Boolean  @default(false)
  private             Boolean  @default(false)
  votes               Int      @default(0)
  status              String   @default("new")
  statusLabel         String?  // free-text label used only when status == "custom" (≤32 chars)
  statusNote          String?  // optional officer note (≤240 chars)
  statusUpdatedById   String?
  statusUpdatedByName String?  // denormalized officer display name
  statusUpdatedAt     DateTime?
  createdAt           DateTime @default(now())

  club      Club?            @relation(fields: [clubId], references: [id], onDelete: SetNull)
  votesList SuggestionVote[]
}

model SuggestionVote {
  id           String   @id @default(cuid())
  suggestionId String
  voterId      String
  createdAt    DateTime @default(now())
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, voterId])
}

model Photo {
  id         String   @id @default(cuid())
  title      String?
  caption    String?
  url        String   // base64 data-URL or external https URL
  audience   String   @default("all")
  authorName String?
  eventLabel String?  // e.g. "Homecoming 2026", "Spirit Week"
  createdAt  DateTime @default(now())
}

model Newsletter {
  id          String   @id @default(cuid())
  title       String
  issueLabel  String?  // "Issue #3", "Spring 2026", etc.
  description String?
  body        String?  // plain-text body (optional)
  externalUrl String?  // link to PDF / Canva / external version
  coverUrl    String?  // base64 or https URL
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

// category: "form" | "doc" | "link"
model ResourceLink {
  id          String   @id @default(cuid())
  title       String
  url         String
  description String?
  category    String   @default("link")
  audience    String   @default("all")
  clubId      String?
  pinned      Boolean  @default(false)
  authorName  String?
  createdAt   DateTime @default(now())

  club Club? @relation(fields: [clubId], references: [id], onDelete: SetNull)
}

// Mailing list — students subscribe to receive SGA updates via email
model MailingList {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?  // optional display name
  createdAt DateTime @default(now())
}

// Public form on /clubs — NOT a club creation form; just a request for SGA to consider
// status: "pending" | "reviewed" | "declined"
model ClubRequest {
  id          String   @id @default(cuid())
  clubName    String
  description String
  contactName String?
  contactInfo String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

// ────────────────────────────────────────────────────────────────
// Transparency suite: meetings, initiatives, budget, voice
// ────────────────────────────────────────────────────────────────

// type: "general" | "executive" | "emergency"
model Meeting {
  id         String   @id @default(cuid())
  date       DateTime
  type       String   @default("general")
  title      String?  // optional subtitle, e.g. "Mid-semester check-in"
  attendees  String   // newline-separated officer names
  agenda     String   // free-text bullets (one per line)
  decisions  String   // free-text bullets — highlighted on public page
  notes      String?  // optional free-form notes
  pinned     Boolean  @default(false)
  authorName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  actionItems ActionItem[]
}

// status: "pending" | "in_progress" | "completed"
model ActionItem {
  id          String    @id @default(cuid())
  meetingId   String
  description String
  assignee    String    // free-text officer name (not all are admin accounts)
  dueDate     DateTime?
  status      String    @default("pending")
  category    String?   // optional tag mirroring initiative categories
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([assignee])
}

// column: "proposed" | "in_progress" | "completed" | "archived"
// category: "academic" | "facilities" | "events" | "policy" | "resources"
model Initiative {
  id           String    @id @default(cuid())
  title        String
  description  String
  owner        String    // free-text officer name
  column       String    @default("proposed")
  category     String    @default("academic")
  startedAt    DateTime?
  expectedAt   DateTime?
  completedAt  DateTime?
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  updates InitiativeUpdate[]

  @@index([column])
  @@index([category])
}

model InitiativeUpdate {
  id           String   @id @default(cuid())
  initiativeId String
  body         String
  authorName   String?
  createdAt    DateTime @default(now())

  initiative Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
}

// Student-submitted initiative ideas the SGA can promote into Initiatives
// status: "pending" | "approved" | "declined"
model InitiativeSuggestion {
  id             String    @id @default(cuid())
  title          String
  description    String    // "why it matters"
  submitterName  String?
  submitterGrade String?
  status         String    @default("pending")
  reviewerNote   String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
}

// One container per academic semester
model BudgetPeriod {
  id        String   @id @default(cuid())
  label     String   @unique  // "Fall 2026", "Spring 2026"
  startsAt  DateTime
  endsAt    DateTime
  total     Float    @default(0) // overall allocation for the period
  current   Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines BudgetLine[]
}

// category: "events" | "operations" | "resources" | "reserves" | "other"
model BudgetLine {
  id        String   @id @default(cuid())
  periodId  String
  category  String   @default("other")
  label     String
  allocated Float    @default(0)
  spent     Float    @default(0)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  period BudgetPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId])
  @@index([category])
}

// type: "concern" | "question" | "suggestion"
// status: "received" | "under_review" | "addressed" | "declined"
model VoiceSubmission {
  id             String   @id @default(cuid())
  ticket         String   @unique // short human-readable lookup code, e.g. "V-A3X9B"
  body           String
  type           String   @default("suggestion")
  submitterName  String?  // null when submitted anonymously
  submitterGrade String?
  isAnonymous    Boolean  @default(true)
  status         String   @default("received")
  responseBody   String?
  respondedAt    DateTime?
  responderName  String?
  declineReason  String?
  votes          Int      @default(0)
  isPublic       Boolean  @default(true) // admin can hide problematic submissions from the public feed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  votesList VoiceVote[]

  @@index([status])
}

model VoiceVote {
  id           String   @id @default(cuid())
  submissionId String
  voterId      String
  createdAt    DateTime @default(now())

  submission VoiceSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, voterId])
}
